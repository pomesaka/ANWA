{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pomesaka/ANWA/main/spec/anwa-0.2.schema.json",
  "title": "ANWA 0.2 Interaction-first experimental manifest",
  "type": "object",
  "required": [
    "anwa",
    "entrypoints",
    "interactions"
  ],
  "additionalProperties": false,
  "properties": {
    "anwa": {
      "const": "0.2"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/InteractionRef"
      }
    },
    "$defs": {
      "type": "object",
      "description": "Optional local reusable payload data schemas (not Thing descriptions). References use #/$defs/Name.",
      "propertyNames": {
        "pattern": "^[A-Za-z_$][\\w$]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "interactions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_$][\\w$]*(?:[.-][A-Za-z_$][\\w$]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Interaction"
      }
    }
  },
  "$defs": {
    "InteractionRef": {
      "type": "string",
      "minLength": 1,
      "description": "App-scoped reference into top-level interactions"
    },
    "ExecutionRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SemanticTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https?://|urn:)[^\\s]+$"
      }
    },
    "Interaction": {
      "type": "object",
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "query",
            "action",
            "event"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "semanticTypes": {
          "$ref": "#/$defs/SemanticTypes"
        },
        "input": {
          "type": "object",
          "description": "Typed input. Local $ref to root #/$defs/Name is supported; full JSON Schema is not implemented"
        },
        "output": {
          "type": "object",
          "description": "Typed success output; may reference a local reusable payload schema"
        },
        "errors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!INVALID_INPUT$|UNEXPECTED_ERROR$)[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "guard": {
          "type": "string",
          "minLength": 1,
          "description": "Optional named Guard for any query, action, or event. The Runtime checks it before running or subscribing; actual authentication is supplied separately by the Adapter."
        },
        "hasSideEffects": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "action"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hasSideEffects"
                  ]
                },
                {
                  "required": [
                    "idempotent"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "Standalone application Interaction definition. No parent Thing or subject type is required or supported."
    },
    "Error": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {},
        "effects": {
          "enum": [
            "none",
            "occurred",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "value"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/Error"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Next": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "Optional application-supplied input to bind a next Interaction"
        },
        "guidance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "retry"
            },
            "level": {
              "enum": [
                "required",
                "recommended",
                "available"
              ]
            }
          }
        },
        "when": {
          "type": "object",
          "required": [
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "after": {
              "type": "string",
              "pattern": "^P(?=.*\\d)(?:\\d+D)?(?:T(?:(?:\\d+)H)?(?:(?:\\d+)M)?(?:(?:\\d+(?:\\.\\d+)?)S)?)?$"
            }
          }
        },
        "applicability": {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "available",
                "blocked",
                "unknown"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "Context": {
      "type": "object",
      "required": [
        "next"
      ],
      "properties": {
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Next"
          }
        }
      },
      "additionalProperties": false
    },
    "InteractionResponse": {
      "type": "object",
      "required": [
        "outcome",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "result"
              ],
              "properties": {
                "kind": {
                  "const": "settled"
                },
                "result": {
                  "$ref": "#/$defs/Result"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "execution"
              ],
              "properties": {
                "kind": {
                  "const": "accepted"
                },
                "execution": {
                  "$ref": "#/$defs/ExecutionRef"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/Context"
        }
      }
    }
  },
  "description": "Interaction-first ANWA 0.2 experimental manifest. Thing, things and subjectType are not part of the core contract; application domain objects are represented via typed Interaction data."
}
