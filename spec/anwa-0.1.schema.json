{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pomesaka/ANWA/main/spec/anwa-0.1.schema.json",
  "title": "ANWA 0.1 experimental Description manifest",
  "type": "object",
  "required": [
    "anwa",
    "entrypoints",
    "things"
  ],
  "additionalProperties": false,
  "properties": {
    "anwa": {
      "const": "0.1"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ThingRef"
      }
    },
    "things": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/Thing"
      }
    }
  },
  "$defs": {
    "ThingRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "InteractionRef": {
      "type": "object",
      "required": [
        "thing",
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "thing": {
          "$ref": "#/$defs/ThingRef"
        },
        "kind": {
          "enum": [
            "property",
            "action",
            "event"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Interaction": {
      "type": "object",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        },
        "guard": {
          "type": "string",
          "minLength": 1
        },
        "errors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!INVALID_INPUT$|UNEXPECTED_ERROR$)[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exhaustive set of domain failure codes this interaction may return; runtime-generated INVALID_INPUT and UNEXPECTED_ERROR are reserved."
        },
        "semanticTypes": {
          "$ref": "#/$defs/SemanticTypes"
        },
        "hasSideEffects": {
          "type": "boolean",
          "description": "Whether invoking this Action may create business-observable effects, including changes to domain state or external systems. false asserts no such effects; omission means unknown. Does not certify authorization or absence of telemetry."
        },
        "idempotent": {
          "type": "boolean",
          "description": "Whether repeated invocations with the same input have the same intended effects as one invocation, considering business-observable effects. Does not imply a safe retry; omission means unknown."
        }
      }
    },
    "Thing": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NonActionInteraction"
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Interaction"
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NonActionInteraction"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "description",
              "target"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "semanticTypes": {
          "$ref": "#/$defs/SemanticTypes"
        }
      }
    },
    "LinkRef": {
      "type": "object",
      "required": [
        "rel",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/ThingRef"
        }
      }
    },
    "AffordanceRef": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/InteractionRef"
        },
        "applicability": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "available",
                "blocked",
                "unknown"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "Context": {
      "type": "object",
      "required": [
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "next": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/NextInteraction"
              },
              {
                "$ref": "#/$defs/NextDiscovery"
              }
            ]
          },
          "description": "Application-provided candidate follow-ups on success, domain failure and accepted work. [] is valid. Neither a ranking nor a command."
        }
      }
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "details": {},
                "effects": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "description": "Expected domain error: code, optional details, per-attempt effects. Retry guidance belongs only in context.next[].guidance."
            }
          }
        }
      ]
    },
    "InteractionResponse": {
      "type": "object",
      "required": [
        "outcome",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "result"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "settled"
                },
                "result": {
                  "$ref": "#/$defs/Result"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "execution"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "accepted"
                },
                "execution": {
                  "$ref": "#/$defs/ThingRef"
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/Context"
        }
      }
    },
    "SemanticTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https?://|urn:)[^\\s]+$"
      },
      "description": "Optional application-chosen machine identifiers of domain meanings; not JSON-LD assertions and not inherently trusted."
    },
    "NonActionInteraction": {
      "allOf": [
        {
          "$ref": "#/$defs/Interaction"
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "hasSideEffects"
                ]
              },
              {
                "required": [
                  "idempotent"
                ]
              }
            ]
          }
        }
      ],
      "description": "Property/Event interactions cannot declare Action-only hasSideEffects or idempotent in this experimental profile."
    },
    "Guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "retry",
          "description": "Marks a proposed repeat of the same Interaction; does not guarantee same input or safety."
        },
        "level": {
          "enum": [
            "required",
            "recommended",
            "available"
          ],
          "description": "Application-supplied importance of the candidate, advisory relative to user's goal; required is not an instruction to override the user."
        }
      },
      "minProperties": 1
    },
    "ExecutionTiming": {
      "type": "object",
      "required": [
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "string",
          "pattern": "^P(?=.*\\d)(?:\\d+D)?(?:T(?:(?:\\d+)H)?(?:(?:\\d+)M)?(?:(?:\\d+(?:\\.\\d+)?)S)?)?$",
          "description": "Positive ISO 8601 duration after receiving this response; an advisory earliest wait, not a timer the runtime enforces."
        }
      }
    },
    "Applicability": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "available",
            "blocked",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "NextInteraction": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/InteractionRef"
        },
        "guidance": {
          "$ref": "#/$defs/Guidance"
        },
        "when": {
          "$ref": "#/$defs/ExecutionTiming"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        }
      },
      "description": "Candidate interaction, including retry when guidance.kind=retry. A reference is advisory, not authorization."
    },
    "NextDiscovery": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "discover"
        },
        "ref": {
          "$ref": "#/$defs/ThingRef"
        },
        "guidance": {
          "$ref": "#/$defs/Guidance"
        },
        "when": {
          "$ref": "#/$defs/ExecutionTiming"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "guidance": {
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "guidance"
            ]
          }
        }
      ],
      "description": "Candidate discovery of a related Thing, not an Action. Retrying an invocation is represented by NextInteraction."
    }
  }
}
