{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "**/*.generated.d.ts"
  ]
}
